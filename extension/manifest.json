{
  "name": "Nextcloud Bookmarks",
  "version": "0.1.4",
  "manifest_version": 3,
  "description": "Unofficial Firefox client for the Nextcloud Bookmarks app: save, search, organize, and import bookmarks.",
  "homepage_url": "https://github.com/tmiland/nextcloud-bookmarks",

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "action": {
    "default_title": "Nextcloud Bookmarks",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },

  "permissions": [
    "activeTab",
    "storage"
  ],

  "optional_permissions": [
    "bookmarks"
  ],

  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "nextcloud-bookmarks@tmiland.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "bookmarksInfo",
          "browsingActivity",
          "searchTerms"
        ]
      }
    }
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
